{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/app/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/mockups", "destination": "/mockups/pocketai-mockups.html" }
  ],
  "redirects": [
    { "source": "/app", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/docs/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/releases/PocketAI.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"PocketAI.apk\"" }
      ]
    },
    {
      "source": "/releases/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
